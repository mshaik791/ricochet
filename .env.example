# ---- Runtime ----
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
STORE_TZ=America/Los_Angeles
LOG_LEVEL=info

# ---- Cox: Lead Management 1.0 ----
# Confirmed in the sandbox 2026-09-27: the key goes in an `api_key` header (the storefront says x-api-key, the
# gateway disagrees) AND every call needs the OAuth bearer from the event-service client below.
COX_LM_BASE_URL=https://sandbox.api.vinsolutions.com
COX_LM_API_KEY=
COX_LM_API_KEY_HEADER=api_key
# Leave blank to reuse COX_EVENTS_TOKEN_URL / CLIENT_ID / CLIENT_SECRET.
COX_LM_TOKEN_URL=
COX_LM_CLIENT_ID=
COX_LM_CLIENT_SECRET=
# The contacts API requires a Vin user id that is associated with the OAuth client. Ask Cox which one.
COX_LM_USER_ID=
# Pilot-only: if a lead arrives with no assigned rep visible through the API, treat it as this rep's.
COX_DEFAULT_REP_ID=
# Used when the dealer API is not in our plan.
STORE_NAME=Dublin Mazda

# ---- Cox: Connect Event Solution 1.0 (sandbox: OAuth client_credentials + API key) ----
COX_EVENTS_BASE_URL=https://sandbox.api.coxautoinc.com/vinsolutions/eventingapi
COX_EVENTS_API_KEY=
# Confirmed 2026-09-27.
COX_EVENTS_TOKEN_URL=https://authentication.vinsolutions.com/connect/token
COX_EVENTS_CLIENT_ID=
COX_EVENTS_CLIENT_SECRET=
COX_EVENTS_SCOPE=PublicAPI

# Sandbox dealer. The shared sandbox subscriber has subscriptions for dealers 1, 12617, 6082, 6210; 12617 has leads.
COX_SANDBOX_DEALER_ID=12617

# ---- Event Sink auth (what Cox sends TO us at /webhooks/cox/events) ----
# Mode must match the auth type you pick when registering the sink in the storefront.
#   header : Cox sends a fixed header (name + value). Default header name x-ricochet-sink-key.
#   basic  : HTTP Basic auth with COX_SINK_BASIC_USER / COX_SINK_BASIC_PASS.
#   bearer : Authorization: Bearer <COX_SINK_SECRET>.
#   none   : development only. Refused when NODE_ENV=production.
COX_SINK_AUTH_MODE=header
COX_SINK_HEADER_NAME=x-ricochet-sink-key
COX_SINK_SECRET=
COX_SINK_BASIC_USER=
COX_SINK_BASIC_PASS=
# Optional comma-separated IP/CIDR allowlist for sink deliveries (ask Jason for egress IPs).
COX_SINK_ALLOWED_IPS=

# ---- Twilio (one local number per rep, 10DLC) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM=

# ---- Postmark ----
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_DOMAIN=mail.getricochet.live
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_INBOUND_SECRET=

# ---- LLM composer (message drafting + onboarding preview) ----
# openai (default) or anthropic. Without a key the deterministic TemplateComposer is used.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Rep onboarding UI ----
SETUP_ADMIN_TOKEN=
