# ---- Runtime ----
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
STORE_TZ=America/Los_Angeles
LOG_LEVEL=info

# ---- Cox: Lead Management 1.0 (sandbox: API key only) ----
COX_LM_BASE_URL=https://sandbox.api.vinsolutions.com
COX_LM_API_KEY=
COX_LM_ACCEPT=application/vnd.coxauto.v3+json
# Optional. Some Cox environments also require an OAuth bearer alongside x-api-key.
# Leave blank for the sandbox unless the product page says otherwise.
COX_LM_TOKEN_URL=
COX_LM_CLIENT_ID=
COX_LM_CLIENT_SECRET=

# ---- Cox: Connect Event Solution 1.0 (sandbox: OAuth client_credentials + API key) ----
COX_EVENTS_BASE_URL=https://sandbox.api.coxautoinc.com/vinsolutions/eventingapi
COX_EVENTS_API_KEY=
COX_EVENTS_ACCEPT=application/vnd.coxauto.v1+json
# Token endpoint is listed on the Connect Event Solution product page. Verify before first run.
COX_EVENTS_TOKEN_URL=https://authentication.vinsolutions.com/connect/token
COX_EVENTS_CLIENT_ID=
COX_EVENTS_CLIENT_SECRET=
COX_EVENTS_SCOPE=PublicAPI

# Sandbox dealer (single dealership). Production dealers come from invitation codes.
COX_SANDBOX_DEALER_ID=

# ---- Event Sink auth (what Cox sends TO us at /webhooks/cox/events) ----
# Mode must match the auth type you pick when registering the sink in the storefront.
#   header : Cox sends a fixed header (name + value). Default header name x-ricochet-sink-key.
#   basic  : HTTP Basic auth with COX_SINK_BASIC_USER / COX_SINK_BASIC_PASS.
#   bearer : Authorization: Bearer <COX_SINK_SECRET>.
#   none   : development only. Refused when NODE_ENV=production.
COX_SINK_AUTH_MODE=header
COX_SINK_HEADER_NAME=x-ricochet-sink-key
COX_SINK_SECRET=
COX_SINK_BASIC_USER=
COX_SINK_BASIC_PASS=
# Optional comma-separated IP/CIDR allowlist for sink deliveries (ask Jason for egress IPs).
COX_SINK_ALLOWED_IPS=

# ---- Twilio (one local number per rep, 10DLC) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM=

# ---- Postmark ----
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_DOMAIN=mail.getricochet.live
POSTMARK_MESSAGE_STREAM=outbound
POSTMARK_INBOUND_SECRET=

# ---- LLM composer (message drafting + onboarding preview) ----
# openai (default) or anthropic. Without a key the deterministic TemplateComposer is used.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Rep onboarding UI ----
SETUP_ADMIN_TOKEN=
